# Force LF line endings for all text files (cross-platform consistency)
* text=auto eol=lf

# Explicit LF for text formats
*.md         text eol=lf
*.txt        text eol=lf
*.dts        text eol=lf
*.dtsi       text eol=lf
*.patch      text eol=lf
*.diff       text eol=lf
*.mk         text eol=lf
*.sh         text eol=lf
*.cfg        text eol=lf
*.conf       text eol=lf
LICENSE      text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
SHA256SUMS   text eol=lf

# Binaries — keep as-is, never convert
*.bin        binary
*.itb        binary
*.img        binary
*.dump       binary
*.gz         binary
*.tar        binary
*.tgz        binary
*.zip        binary
*.7z         binary
*.ko         binary
manifest     text eol=lf
